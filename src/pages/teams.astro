---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import PriceCard from '../components/PriceCard.astro';
import { site } from '../config/site';
const offerings = [
  { id: 'enterprise', title: 'Enterprise deployment & support', body: 'Silent installs and policy-based rollout, centrally managed configs for every machine, and priority support with a named contact.' },
  { id: 'custom', title: 'Custom configs for in-house software', body: "We map your proprietary tools' shortcuts into KeyGnosys profiles, review them with your team, and oversee the rollout so nothing breaks." },
  { id: 'vendors', title: 'Official configs for software vendors', body: "Make your product's shortcuts discoverable to every KeyGnosys user. We build and maintain the official, verified config for your app." },
];
---
<Base title="For teams" description="KeyGnosys is free for everyone. Teams pay for painless rollout, central configuration, priority support and hands-on setup.">
  <div class="wrap page">
    <p class="eyebrow">For teams & vendors</p>
    <h1>KeyGnosys for teams</h1>
    <p class="lede">KeyGnosys is free and open source for everyone, including businesses. Teams pay for what makes a rollout painless: deployment, central configuration, priority support and hands-on setup.</p>
    <div class="grid">
      {offerings.map((o) => (
        <div class="card" id={o.id}><h2>{o.title}</h2><p>{o.body}</p><a href="#contact">Talk to us →</a></div>
      ))}
    </div>
    <section id="workshops">
      <h2>Shortcut workshops</h2>
      <p>Live sessions that make your team fluent in the tools they use every day, with KeyGnosys as the practice surface.</p>
      {site.workshopPricing
        ? <div class="grid">{site.workshopPricing.map((w) => <PriceCard name={w.name} price={`$${w.priceUsd}`} description={w.description} />)}</div>
        : <p><a href="#contact">Contact us for pricing →</a></p>}
    </section>
    <section id="contact">
      <h2>Talk to us</h2>
      <ContactForm />
    </section>
  </div>
</Base>

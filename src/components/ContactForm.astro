---
import { INTERESTS, INTEREST_LABELS } from '../lib/contact';
import { site } from '../config/site';
const mail = `mailto:${site.contactAddress}`;
---
<form id="contact-form" class="contact-form" method="post" action="/api/contact" novalidate data-enhance data-timestamped>
  <p class="form-banner" data-form-banner="send_failed" role="alert" tabindex="-1" hidden>
    We couldn't send this. Email <a href={mail}>{site.contactAddress}</a> directly; your message is still below so you can copy it.
  </p>
  <p class="form-banner" data-form-banner="network" role="alert" tabindex="-1" hidden>
    Couldn't reach the server. Check your connection and try again, or email <a href={mail}>{site.contactAddress}</a>.
  </p>
  <div class="field">
    <label for="cf-name">Name</label>
    <input id="cf-name" name="name" autocomplete="name" required maxlength="100" aria-describedby="cf-name-err" />
    <p class="field-error" id="cf-name-err" data-error-for="name" hidden></p>
  </div>
  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="cf-email-err" />
    <p class="field-error" id="cf-email-err" data-error-for="email" hidden></p>
  </div>
  <div class="field">
    <label for="cf-company">Company <span class="fine">(optional)</span></label>
    <input id="cf-company" name="company" autocomplete="organization" maxlength="100" aria-describedby="cf-company-err" />
    <p class="field-error" id="cf-company-err" data-error-for="company" hidden></p>
  </div>
  <div class="field">
    <label for="cf-interest">I'm interested in</label>
    <select id="cf-interest" name="interest" required aria-describedby="cf-interest-err">
      <option value="">Choose a topic</option>
      {INTERESTS.map((i) => <option value={i}>{INTEREST_LABELS[i]}</option>)}
    </select>
    <p class="field-error" id="cf-interest-err" data-error-for="interest" hidden></p>
  </div>
  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required minlength="10" aria-describedby="cf-message-err"></textarea>
    <p class="field-error" id="cf-message-err" data-error-for="message" hidden></p>
  </div>
  {site.newsletter && (
    <div class="field check">
      <input id="cf-newsletter" type="checkbox" name="newsletter" value="on" />
      <label for="cf-newsletter">Send me release updates and occasional news about KeyGnosys. Unsubscribe anytime.</label>
    </div>
  )}
  <div class="hp" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <input type="hidden" name="t" value="" />
  <button class="btn btn-primary" type="submit">Send message</button>
  <p class="fine">Sent to us by email; this site stores nothing. <a href="/privacy/">Privacy</a></p>
</form>
<script>
  import '../scripts/form-timestamp';
  import '../scripts/enhance-forms';
</script>

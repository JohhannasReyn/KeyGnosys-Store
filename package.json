{
  "name": "keygnosys-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch-content": "tsx scripts/fetch-content.ts",
    "fetch-content:fixtures": "tsx scripts/fetch-content.ts --fixtures default",
    "build:site": "tsx scripts/export-schema.ts && astro build && tsx scripts/postbuild.ts",
    "build": "npm run fetch-content && npm run build:site",
    "build:fixtures": "npm run fetch-content:fixtures && npm run build:site",
    "build:e2e": "tsx scripts/build-e2e.ts",
    "dev": "npm run fetch-content:fixtures && astro dev",
    "preview": "wrangler dev --port 8788",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "tsx scripts/check-static.ts",
    "check:platforms": "tsx scripts/check-platforms.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "check:lighthouse": "tsx scripts/lighthouse.ts",
    "typecheck": "astro check && tsc -p worker --noEmit"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^12.8.2",
    "parse5": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "zod": "^4.6.5"
  }
}
